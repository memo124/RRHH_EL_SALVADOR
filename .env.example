APP_NAME="RRHH El Salvador"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/El_Salvador
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_SV

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- PostgreSQL ---

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rrhh_el_salvador
DB_USERNAME=postgres
DB_PASSWORD=

# Docker Compose (servicio postgres)
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=rrhh_el_salvador
# DB_USERNAME=rrhh
# DB_PASSWORD=rrhh_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@rrhh.sv"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Documentación OpenAPI (Scramble): /docs/api y /docs/api.json
# En local está activa por defecto. En producción use true solo en entornos internos.
SCRAMBLE_ENABLED=true
API_VERSION=1.3.1
